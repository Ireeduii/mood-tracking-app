datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model MindSpaceData {
  id        String   @id @default(uuid())
  date      String   @unique
  mood      String?
  journal   String   @default("")
  todos     Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}